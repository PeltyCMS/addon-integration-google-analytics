{
  "id": "integration-google-analytics",
  "name": "Google Analytics 4",
  "version": "0.1.0",
  "kind": "integration",
  "engine": "wasm",
  "provides": "google_analytics",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.integration.google_analytics",
  "author": "MythicalSystems",
  "permissions": ["network.outbound"],
  "capabilities": {
    "http": ["www.google-analytics.com"],
    "secrets": ["api_secret"],
    "events": ["order.created", "invoice.paid", "user.registered"]
  },
  "settings": [
    { "key": "measurement_id", "label": "Measurement ID (G-XXXXXXX)", "kind": "text", "required": true },
    { "key": "api_secret", "label": "Measurement Protocol API secret", "kind": "secret", "required": true }
  ]
}
